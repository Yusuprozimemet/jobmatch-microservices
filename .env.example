# Used by docker-compose.yml for the Postgres container and the backend's DB connection.
POSTGRES_DB=identity_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# One login per module (Day 11). Compose creates these roles on an empty volume; production gets
# them from scripts/db-setup.py.
IDENTITY_DB_PASSWORD=password
APPLICATIONS_DB_PASSWORD=password
MATCHING_DB_PASSWORD=password
JOBS_DB_PASSWORD=password

# job-service reads the mart from its own database (Day 20).
JOBS_DB_NAME=jobs_db

# The analytics roles on jobs_db (Day 20). Compose creates them on an empty volume; production
# gets them from scripts/db-setup.py.
ANALYTICS_DB_PASSWORD=password
ANALYTICS_DEV_DB_PASSWORD=password

# No token signing key here (Day 12): compose's jwt-key service writes one into the jwt-keys
# volume on the first start, and a key never goes in git.

# Job matching AI scoring (Day 21), read by matching-service only. Optional: with no key
# /api/jobs/top-matches still works and ranks by exact skill overlap.
LLM_API_KEY=
