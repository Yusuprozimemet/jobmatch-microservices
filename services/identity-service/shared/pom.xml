<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>nl.hackyourfuture.project</groupId>
		<artifactId>backend</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>shared</artifactId>

	<!-- shared holds what more than one of the monolith's modules needs, and nothing else: the
	     page wrapper, the ProblemDetail handler and the current user, the records modules call
	     each other with (postings, saved counts, profiles), and the internal clients with their
	     service token. job-service keeps its own copies of the ones it uses (Day 17), so a
	     change to a record here must change there too; the tests that cross the container catch
	     a drift.

	     Every class added here becomes a deployment dependency between services later, so the
	     bar for adding one is "two modules genuinely need it", not "it felt general". -->
	<dependencies>
		<!-- ProblemDetail, @RestControllerAdvice and the exceptions handled. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- BadCredentialsException, which the handler maps to a 401. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- DuplicateKeyException, which the handler maps to a 409. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
		</dependency>
	</dependencies>
</project>
