<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>nl.hackyourfuture.project</groupId>
	<artifactId>backend</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<!-- One module per future service, plus the two that are not services:
	     `shared`, which every module may depend on, and `app`, which is the only thing
	     that boots and the only thing that produces an image.

	     The feature modules are empty today. Day 07 moves the code into them, and the
	     point of creating them first is that the dependency rule can be enforced before
	     there is anything to enforce it against: no feature module may depend on another,
	     only on `shared`. -->
	<modules>
		<module>shared</module>
		<module>identity</module>
		<module>jobs</module>
		<module>applications</module>
		<module>matching</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<springdoc.version>3.1.0</springdoc.version>
	</properties>

	<!-- Versions for what Spring Boot's parent does not manage. Here rather than in each
	     module, so two modules cannot end up on two versions of the same library. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Inherited by every module. spring-boot-maven-plugin is deliberately not here:
	     it belongs to `app` alone, or every module tries to produce an executable jar. -->
	<build>
		<plugins>
			<!-- The dependency rule, as a build failure rather than a convention. A feature
			     module may depend on shared and on nothing else of ours; the moment one needs
			     another, that is a boundary being crossed and the build says so. `app` is the
			     exception and switches this off, because it is what assembles them all. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>feature-modules-depend-only-on-shared</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>nl.hackyourfuture.project:*</exclude>
									</excludes>
									<includes>
										<include>nl.hackyourfuture.project:shared</include>
									</includes>
									<message>A feature module may depend on shared and on nothing else of ours. Needing another module is a boundary being crossed - publish an interface instead.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Surefire's defaults, plus *IT. The contract tests are named *IT because
					     they drive the application over HTTP, and a plain `mvnw verify` - which is
					     what CI runs - has to run them. Listing the defaults is not optional:
					     <includes> replaces them rather than adding to them. -->
					<includes>
						<include>**/Test*.java</include>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- Absolute, because a bare filename is resolved against each module's
					     own directory and every module but this one would fail. -->
					<configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
					<consoleOutput>true</consoleOutput>
					<failOnViolation>true</failOnViolation>
					<violationSeverity>warning</violationSeverity>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
