SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_db
# The owner of the migrations; only Flyway logs in as it. app_user where db-setup.py made the database.
DB_USER=admin
DB_PASSWORD=password
# One login per module (Day 11), each with its own schema as the search path. The prod profile has
# no defaults for these; db-setup.py prints the passwords it made.
DB_IDENTITY_USER=identity_user
DB_IDENTITY_PASSWORD=password
DB_APPLICATIONS_USER=applications_user
DB_APPLICATIONS_PASSWORD=password
DB_MATCHING_USER=matching_user
DB_MATCHING_PASSWORD=password
DB_JOBS_USER=jobs_user
DB_JOBS_PASSWORD=password

# Public address of this environment. No trailing slash: the OAuth redirect URIs are
# built by appending to it, and a double slash will not match what Google has registered.
# On production this is https://c55c.hyf.dev
APP_BASE_URL=http://localhost:3000
# The RSA key tokens are signed with (Day 12). The backend does not start without it and never
# makes one. Write it once from the repository root, then use the absolute path:
#   scripts/jwt-key.sh backend/.jwt/private.pem
# Compose sets this itself, to the key its jwt-key service writes.
JWT_PRIVATE_KEY_FILE=
# The monolith's own key for service tokens (Day 39). The backend does not start without it.
# Write it once from the repository root, then use the absolute path:
#   scripts/jwt-key.sh backend/.jwt/service.pem
# Compose sets this itself, to the key its jwt-key service writes.
SERVICE_JWT_PRIVATE_KEY_FILE=
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# brevo email notification service for password reset
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_password
# Job matching AI scoring. Optional: with no key /api/jobs/top-matches still works and
# ranks by exact skill overlap. Any OpenAI-compatible provider works (Gemini, Groq) -
# change base-url and model rather than code.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest
# How long to wait for the scoring reply before giving up and returning the skill-overlap
# order. A cold shortlist takes ~4s on a flash-tier model, so this is headroom, not a target.
LLM_TIMEOUT_SECONDS=20

LLM_SCORE_RETENTION_DAYS=1
LLM_SCORE_PURGE_CRON=0 0 * * * *
