<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>nl.hackyourfuture.project</groupId>
		<artifactId>backend</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>shared</artifactId>

	<!-- Everything more than one module needs, and nothing else. Three classes today:
	     PageResponse, which jobs and applications both page with; GlobalExceptionHandler,
	     which turns exceptions into the ProblemDetail bodies every endpoint's contract is
	     written against; and MartSkills.

	     MartSkills is here under protest. jobs and applications both parse the mart's
	     skills column today, so it cannot live in either. Day 09 removes applications'
	     reason to read mart columns at all - take it out of shared then.

	     Every class added here becomes a deployment dependency between services later, so
	     the bar for adding a fourth is "two modules genuinely need it", not "it felt
	     general". -->
	<dependencies>
		<!-- ProblemDetail, @RestControllerAdvice and the exceptions handled, plus the
		     Jackson that MartSkills parses with. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- BadCredentialsException, which the handler maps to a 401. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- DuplicateKeyException, which the handler maps to a 409. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
		</dependency>
		<!-- The @Schema annotations on PageResponse. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
		</dependency>
	</dependencies>
</project>
